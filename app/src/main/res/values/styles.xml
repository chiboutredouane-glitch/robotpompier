<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF654E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101722</item>
        <item name="android:navigationBarColor">#101722</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#101722</item>
    </style>
    <style name="CommandButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_command</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
